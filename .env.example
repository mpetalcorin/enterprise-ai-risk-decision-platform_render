APP_ENV=development
LOG_LEVEL=INFO
MODEL_BACKEND=xgboost
MODEL_PATH=/app/models/risk_model.joblib
MODEL_VERSION=local-dev
DECISION_THRESHOLD=0.65
DATABASE_URL=postgresql+psycopg2://risk_user:risk_password@postgres:5432/riskdb
REQUIRE_API_KEY=true
API_KEY=change-me-before-production
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=enterprise-risk-platform
MLFLOW_REGISTERED_MODEL=enterprise-risk-model
